{
  "name": "GraveFallGame",
  "version": "1.0.0",
  "description": "A Rune-based action strategy roguelite game.",
  "main": "bin/bootstrap.js",
  "scripts": {
    "test": "electron ./bin-debug/bootstrap.js",
    "start": "electron ./bin/bootstrap.js",
    "build": "cd scripts/shell && bash make.sh",
    "dist": "npm run build && electron-builder --win portable",
    "dist:dir": "npm run build && electron-builder --win dir"
  },
  "author": "Rasmus & Kajus",
  "license": "MIT",
  "devDependencies": {
    "google-closure-compiler": "*",
    "jsdoc": "*",
    "electron": "*",
    "electron-builder": "*"
  },
  "build": {
    "appId": "com.gravefall.game",
    "productName": "GraveFallGame",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "bin/**/*",
      "dist/GraveFallGame.js",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.games"
    }
  }
}